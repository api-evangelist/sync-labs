{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sync Labs Assets Models API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Available Models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sync.so/v2/models"
          },
          "docs": "Retrieve the list of available AI lip-sync models and their capabilities"
        }
      ]
    }
  ],
  "bundled": true
}